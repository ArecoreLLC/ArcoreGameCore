      "id": "adaptive-music-stems",
      "title": "Adaptive Music Stems (Suno -> Sonic Alchemist -> Engine)",
      "status": "scaffold",
      "kind": "existing",
      "source_component": "Suno MCP + GameMusic",
      "target_component": "ArcoreSonicAlchemist -> Unreal 5.8 / Godot",
      "summary": "Generate clean stem-builder prompts, audition/analyze takes, extract 12-stem WAVs & 0-credit MIDIs, slice 32-bar loops in Sonic Alchemist, and wire 4-layer bar-quantized adaptive audio into Unreal/Godot.",
      "guide_path": "workflows/adaptive-music-stems/README.md",
      "tool_path": "tools/sonic_adaptive_pipeline.py",
      "handoffs": [
        { "from": "GameCore Music DB", "to": "Suno MCP", "artifact": "Clean Stem-Builder style + lyrics prompt", "contract": "hub/data/music-design/<game>.json" },
        { "from": "Suno Studio / MCP", "to": "GameMusic", "artifact": "Stem ZIP / WAVs + 0-credit MIDI stems", "contract": "X:/Projects/GameMusic/<Game>/" },
        { "from": "GameMusic", "to": "ArcoreSonicAlchemist", "artifact": "4 hero stems + 32-bar loop Design.json", "contract": "tools/sonic_adaptive_pipeline.py" },
        { "from": "ArcoreSonicAlchemist", "to": "Unreal / Godot Consumer", "artifact": "48kHz 24-bit layer-01..04.wav + verified-copies.json", "contract": "shared/migration-contract.md" }
      ],
      "stages": [
        { "step": "1. Prompt & Suno generation", "owner": "GameCore + Suno", "tool_or_guide": "tools/adaptive_music_prompts.py", "acceptance": "Instrumental, steady BPM, stem-separated layers" },
        { "step": "2. Stem & MIDI extraction", "owner": "Suno Studio / MCP", "tool_or_guide": "X:/Projects/GameMusic/<Game>/", "acceptance": "Non-empty WAV stems + .mid files linked in Music DB" },
        { "step": "3. Loop slice & acoustic gate", "owner": "Sonic Alchemist", "tool_or_guide": "tools/sonic_adaptive_pipeline.py", "acceptance": "seam_step < 0.001, coherent peak < 0.99, 48kHz 24-bit" },
        { "step": "4. Engine wiring & cook", "owner": "Game Consumer", "tool_or_guide": "DefaultGame.ini + USoundWave / AudioStreamPlayer", "acceptance": "Explore/Tension/Combat/Boss bar-quantized transitions" }
      ]
    },
