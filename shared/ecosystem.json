{
  "schema_version": 1,
  "components": [
    {
      "id": "gamecore",
      "root": ".",
      "role": "Workflow hub and engine-neutral contracts",
      "required_files": [
        "workflows/index.json",
        "project.godot"
      ],
      "runtime": "godot-legacy"
    },
    {
      "id": "world-framework",
      "root": "../ArcoreWorldFramework",
      "role": "Reusable validation, geometry and engine adapters",
      "required_files": [
        "pyproject.toml",
        "Unreal/ArcoreFrameworkRuntime/ArcoreFrameworkRuntime.uplugin"
      ],
      "runtime": "shared-and-adapters"
    },
    {
      "id": "openworld",
      "root": "../ArcoreOpenWorld",
      "role": "Reference Unreal consumer; authored maps remain project-owned",
      "required_files": [
        "ArcoreOpenWorld.uproject",
        "Tools/unreal_mcp.py"
      ],
      "runtime": "unreal"
    },
    {
      "id": "model-forge",
      "root": "../ArcoreModelForge",
      "role": "Versioned model catalog and existing modeling MCP",
      "required_files": [
        "README.md",
        "src-tauri/src/mcp.rs"
      ],
      "runtime": "asset-service",
      "versioned_modules": [
        {
          "id": "hairlab",
          "manifest": "texture-lab/hairlab.json",
          "check": "python texture-lab/hairlab_version.py",
          "pin": "workflows/hair-fur-textures/pin.json"
        }
      ]
    },
    {
      "id": "sound-core",
      "root": "../ArcoreSoundCore",
      "role": "Sound catalog, provenance and existing audio MCP",
      "required_files": [
        "catalog/sounds.json",
        "docs/agents.md"
      ],
      "runtime": "asset-service"
    },
    {
      "id": "flow",
      "root": "../ArcoreFlow-repo",
      "role": "Workflow designer; shows wizard runs as graphs through its optional gamedev node pack",
      "required_files": [
        "package.json",
        "packages/node-registry/src/index.ts"
      ],
      "runtime": "workflow-designer"
    },
    {
      "id": "arcore-cut",
      "root": "../ArcoreCut",
      "role": "Rust/Tauri video production workspace, SQLite timelines, lossless scene validation and MCP",
      "required_files": [
        "src-tauri/Cargo.toml",
        "src-tauri/src/api.rs"
      ],
      "runtime": "rust-tauri"
    },
    {
      "id": "photo-master",
      "root": "../arcorephotomaster",
      "role": "Non-destructive photo editing and photo-derived texture sets",
      "required_files": [
        "Cargo.toml",
        "crates/photo-mcp/src/main.rs"
      ],
      "runtime": "rust-tauri"
    },
    {
      "id": "arcore-animate",
      "root": "../ArcoreAnimate",
      "role": "Detailed animation authoring, move library, choreography and app-owned workers",
      "required_files": [
        "studio/mcp_server.py",
        "studio/server.py"
      ],
      "runtime": "animation-service"
    }
  ],
  "mcp": {
    "hub": {
      "id": "gamecore-hub",
      "status": "media-implemented-wizards-planned",
      "command": [
        "hub/src-tauri/target/release/gamecore-library.exe",
        "--mcp"
      ],
      "implemented_tools": [
        "list_projects",
        "list_media",
        "import_media",
        "video_production",
        "animation_production",
        "animation_pipeline"
      ],
      "role": "The only MCP server agents register. It exposes wizard-level tools and calls the servers below itself, with typed arguments and no LLM in the loop.",
      "transport": "stdio",
      "tools": [
        {
          "name": "list_projects",
          "writes": false,
          "purpose": "List local catalog projects; implemented"
        },
        {
          "name": "list_media",
          "writes": false,
          "purpose": "Read media and import-time Git iteration tags; implemented"
        },
        {
          "name": "import_media",
          "writes": true,
          "purpose": "Import local media as draft with automatic screenshot iteration tags; implemented"
        },
        {
          "name": "list_wizards",
          "writes": false,
          "purpose": "Wizard templates, their status and assistance level"
        },
        {
          "name": "describe_wizard",
          "writes": false,
          "purpose": "Fields, presets, stages and review gates for one template"
        },
        {
          "name": "check_readiness",
          "writes": false,
          "purpose": "Capability probes and downstream MCP availability for a template"
        },
        {
          "name": "plan_run",
          "writes": false,
          "purpose": "Validate inputs and return the resolved plan without running it"
        },
        {
          "name": "start_run",
          "writes": true,
          "purpose": "Start a validated plan; returns a run id"
        },
        {
          "name": "get_run",
          "writes": false,
          "purpose": "Run state, stage progress, artifacts and pending reviews"
        },
        {
          "name": "cancel_run",
          "writes": true,
          "purpose": "Cancel owned work; completed outputs are kept"
        },
        {
          "name": "submit_review",
          "writes": true,
          "purpose": "Record a human review decision bound to exact artifact revisions"
        },
        {
          "name": "publish_to_flow",
          "writes": true,
          "purpose": "Create or update the matching ArcoreFlow workflow for a template or run"
        },
        {
          "name": "video_production",
          "writes": true,
          "purpose": "Registry-routed ArcoreCut production operations; tool returns persistent jobs for media work"
        },
        {
          "name": "animation_production",
          "writes": true,
          "purpose": "Registry-routed detailed Animate operations"
        },
        {
          "name": "animation_pipeline",
          "writes": true,
          "purpose": "Persistent GameCore stage orchestration using Animate jobs"
        }
      ]
    },
    "servers": [
      {
        "id": "model-forge",
        "label": "ArcoreModelForge",
        "component": "model-forge",
        "transport": "streamable-http",
        "url": "http://127.0.0.1:{port}/mcp",
        "connection": "ModelForge must be open with its agent API on; port and token are read from ~/.modelvault/settings.json.",
        "auth": {
          "type": "bearer",
          "token_env": "ARCORE_MCP_TOKEN_MODEL_FORGE",
          "url_env": "ARCORE_MCP_URL_MODEL_FORGE"
        },
        "tools": [
          "get_model",
          "check_model",
          "blender_run",
          "blender_render",
          "create_design_iteration"
        ],
        "write_tools": [
          "blender_run",
          "create_design_iteration",
          "check_model"
        ],
        "discovery": {
          "file": "~/.modelvault/settings.json",
          "url": "http://127.0.0.1:{agentPort}/mcp",
          "token_key": "agentToken",
          "enabled_key": "agentEnabled",
          "disabled_hint": "Turn on the agent API in ModelForge > Settings."
        }
      },
      {
        "id": "sound-core",
        "label": "Arcore SoundCore",
        "component": "sound-core",
        "transport": "streamable-http",
        "url": "http://127.0.0.1:{port}/mcp",
        "connection": "SoundCore must be open; it writes its current URL and token to service.json in its app data folder.",
        "auth": {
          "type": "bearer",
          "token_env": "ARCORE_MCP_TOKEN_SOUND_CORE",
          "url_env": "ARCORE_MCP_URL_SOUND_CORE"
        },
        "tools": [
          "list_categories",
          "search_sounds",
          "get_sound",
          "collect_sounds"
        ],
        "write_tools": [
          "collect_sounds"
        ],
        "discovery": {
          "file": "%APPDATA%/com.arcore.soundcore/service.json",
          "url": "{url}/mcp",
          "token_key": "token"
        }
      },
      {
        "id": "unreal-editor",
        "label": "Unreal Editor (OpenWorld)",
        "component": "openworld",
        "transport": "streamable-http",
        "url": "http://127.0.0.1:8000/mcp",
        "connection": "Epic's built-in editor MCP; the project must be open in the editor. Tools are schema-discovered per call sequence, never assumed.",
        "auth": {
          "type": "none",
          "url_env": "ARCORE_MCP_URL_UNREAL_EDITOR"
        },
        "tools": [],
        "write_tools": []
      },
      {
        "id": "arcore-flow",
        "label": "ArcoreFlow",
        "component": "flow",
        "transport": "stdio",
        "command": [
          "node",
          "packages/mcp-server/src/index.mjs"
        ],
        "connection": "Spawned from the Flow checkout; needs the Flow API gateway (FLOW_GATEWAY_URL) and ARCORE_NODE_PACKS=gamedev on its workflow service.",
        "auth": {
          "type": "env",
          "env": {
            "FLOW_NODE_PACKS": "gamedev"
          },
          "token_env": "FLOW_TOKEN"
        },
        "tools": [
          "list_nodes",
          "get_node",
          "validate_workflow",
          "create_workflow",
          "update_workflow",
          "publish_workflow",
          "list_versions",
          "generate_workflow_from_wizard"
        ],
        "write_tools": [
          "create_workflow",
          "update_workflow",
          "publish_workflow",
          "generate_workflow_from_wizard"
        ]
      },
      {
        "id": "arcore-cut",
        "label": "ArcoreCut",
        "component": "arcore-cut",
        "transport": "stdio",
        "command": [
          "src-tauri/target/debug/arcore-cut.exe",
          "--mcp"
        ],
        "connection": "Build ArcoreCut first. GameCore video_production routes calls here; GAMEVIDEO_ROOT optionally selects the media library.",
        "auth": {
          "type": "none"
        },
        "tools": [
          "video_captions",
          "video_caption_export",
          "video_scripts",
          "video_app",
          "video_projects",
          "video_project",
          "video_import",
          "video_timing",
          "video_mix",
          "video_validate",
          "video_render",
          "video_replace",
          "video_jobs",
          "video_cancel",
          "video_workflows"
        ],
        "write_tools": [
          "video_captions",
          "video_caption_export",
          "video_scripts",
          "video_app",
          "video_import",
          "video_timing",
          "video_mix",
          "video_validate",
          "video_render",
          "video_replace",
          "video_cancel",
          "video_workflows"
        ]
      },
      {
        "id": "photo-master",
        "label": "Arcore PhotoMaster",
        "component": "photo-master",
        "transport": "stdio",
        "command": [
          "target/debug/photo-mcp.exe",
          "--workspace",
          "X:/Projects/GameVideo"
        ],
        "connection": "Headless workspace for production images and texture sets. Session-based editing needs a persistent provider connection; no automatic engine-material import is claimed.",
        "auth": {
          "type": "none"
        },
        "tools": [
          "studio_state",
          "open_image",
          "set_adjustments",
          "transform",
          "preview",
          "save_project",
          "export_image",
          "texture_source",
          "set_texture_selection",
          "set_texture_settings",
          "texture_preview",
          "export_textures"
        ],
        "write_tools": [
          "open_image",
          "set_adjustments",
          "transform",
          "save_project",
          "export_image",
          "set_texture_selection",
          "set_texture_settings",
          "export_textures"
        ]
      },
      {
        "id": "arcore-animate",
        "label": "ArcoreAnimate",
        "component": "arcore-animate",
        "transport": "stdio",
        "command": [
          "../ArcoreGameCore/tools/drawing-studio/.venv-vision/Scripts/python.exe",
          "studio/mcp_server.py"
        ],
        "connection": "GameCore animation_production routes here. animate_app starts or inspects the local Animate service; service discovery stays in LocalAppData/ArcoreAnimate/service.json. Detailed jobs remain in Animate.",
        "auth": {
          "type": "none"
        },
        "tools": [
          "animate_app",
          "animate_companion_pack",
          "animate_import_corrections",
          "animate_state",
          "animate_history",
          "animate_save_brief",
          "animate_add_take",
          "animate_import_takes",
          "animate_save_anchors",
          "animate_tracks",
          "animate_frame",
          "animate_guide",
          "animate_rom",
          "animate_save_rom",
          "animate_retarget_report",
          "animate_moves",
          "animate_save_moves",
          "animate_start_job",
          "animate_jobs",
          "animate_cancel_job",
          "animate_library",
          "animate_artifact"
        ],
        "write_tools": [
          "animate_app",
          "animate_save_brief",
          "animate_add_take",
          "animate_import_takes",
          "animate_save_anchors",
          "animate_save_rom",
          "animate_save_moves",
          "animate_start_job",
          "animate_cancel_job",
          "animate_companion_pack",
          "animate_import_corrections"
        ]
      }
    ]
  }
}
